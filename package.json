{
	"name": "kilo",
	"private": true,
	"version": "3.3.1",
	"type": "module",
	"packageManager": "bun@1.4.5",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"preinstall": "bun -e \"const ua = process.env.npm_config_user_agent || ''; if (ua.startsWith('bun/')) process.exit(0); console.error('Kilo requires Bun (>= 1.4.0). Use bun install instead.'); process.exit(1);\"",
		"start": "bun --bun gpuix-svelte --bun app.ts",
		"test": "bun --bun gpuix-svelte --bun test.ts",
		"build": "bun build.ts",
		"typecheck": "bun --bun tsc --noEmit && bun --bun svelte-check --diagnostic-sources js,svelte --fail-on-warnings"
	},
	"trustedDependencies": [
		"sharp"
	],
	"dependencies": {
		"gifuct-js": "^2.1.2",
		"gpuix-svelte": "^0.6.0",
		"gpuix-svelte-ui": "^0.6.0",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3"
	}
}
