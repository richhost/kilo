{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"customConditions": ["custom-renderer", "development"],
		"types": ["bun", "gpuix-svelte/html"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"svelte": ["./node_modules/gpuix-svelte/node_modules/svelte"],
			"svelte/*": ["./node_modules/gpuix-svelte/node_modules/svelte/*"]
		}
	},
	"svelteOptions": { "namespace": "gpuixHTML" },
	"include": ["*.ts", "*.svelte", "src/**/*.ts", "src/**/*.svelte"],
	"exclude": [".native-assets.ts", ".standalone-build.ts", "dist", "node_modules"]
}
